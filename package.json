{
  "name": "havs-workspace",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:server": "playwright test --config playwright.server.config.ts",
    "server": "node --experimental-strip-types server/index.mjs",
    "start": "node --experimental-strip-types server/index.mjs",
    "admin": "node --experimental-strip-types server/manage.mjs",
    "dev:full": "node scripts/dev.mjs",
    "cf:dev": "node scripts/cloudflare-dev.mjs",
    "cf:setup": "node scripts/cloudflare-setup.mjs",
    "cf:deploy": "node scripts/cloudflare-deploy.mjs",
    "cf:admin": "node scripts/cloudflare-admin.mjs",
    "test:cloudflare": "node --experimental-strip-types --test tests/cloudflare-*.test.mjs",
    "test:e2e:cloudflare": "playwright test --config playwright.cloudflare.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "^5.3.1",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20261012.1-beta",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "4.151.1"
  }
}
